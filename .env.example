# Local development only. Copy to .env at the repository root to override defaults.
PRISM_DATABASE_URL=postgresql+psycopg://prism:prism@127.0.0.1:5432/prism
PRISM_FRONTEND_ORIGIN=http://127.0.0.1:3000
PRISM_DATA_DIR=./data
# Optional retrieval cutoffs; defaults match the development-set settings.
PRISM_SEARCH_SIMILARITY_CUTOFF=0.30
PRISM_VISUAL_SIMILARITY_CUTOFF=0.285
PRISM_SILENT_VISUAL_SIMILARITY_CUTOFF=0.25
